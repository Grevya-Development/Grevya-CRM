# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by git.

# ---------------------------------------------------------------
# Frontend (Vite)
# Anything prefixed with VITE_ is bundled into the browser code,
# so only put public / non-secret values here.
# ---------------------------------------------------------------

# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI backend (the Grevya AI chat calls {VITE_API_URL}/ask-ai)
VITE_API_URL=http://localhost:8000

# Mail service
VITE_MAILER_API_URL=http://localhost:3001/api

# Voice assistant (AssemblyAI speech-to-text)
VITE_ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Company enrichment (People Data Labs)
VITE_PDL_API=https://api.peopledatalabs.com/v5/autocomplete
VITE_PDL_API_KEY=your_pdl_api_key

# Demo login (development only)
VITE_LOGIN_EMAIL=admin@example.com
VITE_LOGIN_PASSWORD=change_me

# ---------------------------------------------------------------
# Backend only (server-side secrets — never add a VITE_ prefix)
# ---------------------------------------------------------------

# Anthropic Claude — used by the AI backend that serves /ask-ai
ANTHROPIC_API_KEY=your_anthropic_api_key

# Direct Postgres connection, used only to apply database migrations
# (supabase/migrations). Supabase -> Connect -> Session pooler URI (works on IPv4);
# percent-encode special characters in the password (e.g. @ -> %40).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_url_encoded_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres
